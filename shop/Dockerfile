FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_DB_URL
ARG NEXT_PUBLIC_DB_NAME
ARG NEXT_PUBLIC_ACCESS_TOKEN_KEY
ARG NEXT_PUBLIC_REFRESH_TOKEN_KEY
ARG NEXT_PUBLIC_NODEMAILER_PW
ARG NEXT_PUBLIC_NODEMAILER_EMAIL
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ARG NEXT_PUBLIC_GEOAPIFY_API_KEY
ARG NEXT_PUBLIC_TOMTOM_API_KEY
ARG NEXT_PUBLIC_NOVA_POSHTA_API_KEY
ARG WAYFORPAY_MERCHANT_ACCOUNT
ARG WAYFORPAY_MERCHANT_SECRET_KEY
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_IMAGE_BASE_URL
ARG CLOUDINARY_CLOUD_NAME
ARG CLOUDINARY_API_KEY
ARG CLOUDINARY_API_SECRET

RUN echo "NEXT_PUBLIC_DB_URL=${NEXT_PUBLIC_DB_URL}" >> .env && \
    echo "NEXT_PUBLIC_DB_NAME=${NEXT_PUBLIC_DB_NAME}" >> .env && \
    echo "NEXT_PUBLIC_ACCESS_TOKEN_KEY=${NEXT_PUBLIC_ACCESS_TOKEN_KEY}" >> .env && \
    echo "NEXT_PUBLIC_REFRESH_TOKEN_KEY=${NEXT_PUBLIC_REFRESH_TOKEN_KEY}" >> .env && \
    echo "NEXT_PUBLIC_NODEMAILER_PW=${NEXT_PUBLIC_NODEMAILER_PW}" >> .env && \
    echo "NEXT_PUBLIC_NODEMAILER_EMAIL=${NEXT_PUBLIC_NODEMAILER_EMAIL}" >> .env && \
    echo "NEXT_PUBLIC_FIREBASE_API_KEY=${NEXT_PUBLIC_FIREBASE_API_KEY}" >> .env && \
    echo "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN}" >> .env && \
    echo "NEXT_PUBLIC_FIREBASE_PROJECT_ID=${NEXT_PUBLIC_FIREBASE_PROJECT_ID}" >> .env && \
    echo "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=${NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET}" >> .env && \
    echo "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID}" >> .env && \
    echo "NEXT_PUBLIC_FIREBASE_APP_ID=${NEXT_PUBLIC_FIREBASE_APP_ID}" >> .env && \
    echo "NEXT_PUBLIC_GEOAPIFY_API_KEY=${NEXT_PUBLIC_GEOAPIFY_API_KEY}" >> .env && \
    echo "NEXT_PUBLIC_TOMTOM_API_KEY=${NEXT_PUBLIC_TOMTOM_API_KEY}" >> .env && \
    echo "NEXT_PUBLIC_NOVA_POSHTA_API_KEY=${NEXT_PUBLIC_NOVA_POSHTA_API_KEY}" >> .env && \
    echo "WAYFORPAY_MERCHANT_ACCOUNT=${WAYFORPAY_MERCHANT_ACCOUNT}" >> .env && \
    echo "WAYFORPAY_MERCHANT_SECRET_KEY=${WAYFORPAY_MERCHANT_SECRET_KEY}" >> .env && \
    echo "NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_BASE_URL}" >> .env && \
    echo "NEXT_PUBLIC_IMAGE_BASE_URL=${NEXT_PUBLIC_IMAGE_BASE_URL}" >> .env && \
    echo "CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}" >> .env && \
    echo "CLOUDINARY_API_KEY=${CLOUDINARY_API_KEY}" >> .env && \
    echo "CLOUDINARY_API_SECRET=${CLOUDINARY_API_SECRET}" >> .env

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000

CMD ["node", "server.js"]