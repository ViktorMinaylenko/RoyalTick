@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam entityBackgroundColor #FAFAFA
skinparam entityBorderColor #333333
skinparam entityArrowColor #444444
skinparam entityHeaderBackgroundColor #D0D0D0
skinparam entityFontStyle bold
skinparam entityFontSize 12
skinparam padding 6
skinparam nodesep 30
skinparam ranksep 35
skinparam shadowing false

title Скорочена діаграма колекцій бази даних RoyalTick

entity "users" as U {
  * _id : ObjectId
  --
  name, email, role
  balance, isVerified
  sellerRating, buyerRating
}

entity "watches" as W {
  * _id : ObjectId
  --
  name, price, category
  characteristics, inStock
}

entity "straps" as ST {
  * _id : ObjectId
  --
  name, price, category
  characteristics, inStock
}

entity "boxes" as BX {
  * _id : ObjectId
  --
  name, price, category
  characteristics, inStock
}

entity "care" as CR {
  * _id : ObjectId
  --
  name, price, category
  characteristics, inStock
}

entity "lots" as L {
  * _id : ObjectId
  --
  title, saleType, status
  currentPrice, userId
  bids[], endDate
}

entity "chats" as CH {
  * _id : ObjectId
  --
  lotId, winnerId, ownerId
  status, messages[]
  dealCompletedByOwner
  dealCompletedByWinner
}

entity "cart" as CA {
  * _id : ObjectId
  --
  userId, productId
  category, count, price
}

entity "favorites" as FA {
  * _id : ObjectId
  --
  userId, productId
  category, price
}

entity "comparison" as CM {
  * _id : ObjectId
  --
  userId, productId
  category, characteristics
}

entity "topics" as T {
  * _id : ObjectId
  --
  title, body, category
  userId, messages[]
  likes[], views
}

entity "notifications" as N {
  * _id : ObjectId
  --
  userId, type
  isRead, href
}

entity "codes" as CO {
  * _id : ObjectId
  --
  code, oldEmail
  newEmail
}

entity "images" as IM {
  * _id : ObjectId
  --
  imgId, src, title
}

W -[hidden]right- ST
ST -[hidden]right- BX
BX -[hidden]right- CR

CA -[hidden]right- FA
FA -[hidden]right- CM

N -[hidden]right- CO
CO -[hidden]right- IM

U ||--o{ L : "userId"
U ||--o{ CA : "userId"
U ||--o{ FA : "userId"
U ||--o{ CM : "userId"
U ||--o{ T : "userId"
U ||--o{ N : "userId"
U ||--o{ CO : "userId"

L ||--o| CH : "lotId"

W ||--o{ CA : "productId"
W ||--o{ FA : "productId"
W ||--o{ CM : "productId"

ST ||--o{ CA : "productId"
ST ||--o{ FA : "productId"
ST ||--o{ CM : "productId"

BX ||--o{ CA : "productId"
BX ||--o{ FA : "productId"
BX ||--o{ CM : "productId"

CR ||--o{ CA : "productId"
CR ||--o{ FA : "productId"
CR ||--o{ CM : "productId"
@enduml